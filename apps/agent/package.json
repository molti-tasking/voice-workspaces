{
  "name": "@voicemural/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../.env src/index.ts dev",
    "start": "tsx src/index.ts start",
    "build": "echo 'agent runs from TypeScript source via tsx'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx src/smoke.mjs"
  },
  "dependencies": {
    "@livekit/agents": "^1.6.4",
    "@livekit/agents-plugin-elevenlabs": "^1.6.4",
    "@livekit/agents-plugin-openai": "^1.6.4",
    "@livekit/agents-plugin-silero": "^1.6.4",
    "@livekit/rtc-node": "^0.13.33",
    "@voicemural/db": "workspace:*",
    "@voicemural/llm": "workspace:*",
    "@voicemural/shared": "workspace:*",
    "@voicemural/talkback": "workspace:*",
    "@voicemural/telemetry": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "livekit-server-sdk": "^2.17.0",
    "tsx": "4.20.6",
    "ws": "^8.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@types/ws": "^8.5.13"
  }
}
