# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. pg-boss shares this database (schema: pgboss).
DATABASE_URL=postgresql://voicemural:voicemural@localhost:5432/voicemural

# --- LiteLLM ----------------------------------------------------------------
# All model calls route through the LiteLLM proxy. Never hard-code model names
# in application code — reference the role-based vars below so models can be
# swapped without a code change.
LITELLM_BASE_URL=https://litellm.your-instance.example/v1
LITELLM_API_KEY=sk-...

# Role -> model mapping. Ask your LiteLLM admin for a virtual key per person so
# usage and budget are attributable.
#
# MODEL NAMES ARE INSTANCE-SPECIFIC. The CAVI proxy namespaces everything, so
# bare `whisper-1` does not exist there — it is `openai/whisper-1`. The worker
# checks these against /v1/models on startup and names the ones it can see, so
# a wrong value is reported once at boot instead of failing per chunk.
#
# Defaults below are self-hosted and open source, which keeps recordings of
# people thinking aloud on university infrastructure — worth keeping that way
# once the field study has participants.
MODEL_TRANSCRIBE=cavi/faster-whisper-large-v3
MODEL_FAST=cavi/gemma3:12b

# Crystallisation quality matters more than speed here, so this one defaults to
# a hosted model. Switching to e.g. cavi/gpt-oss:20b or natai/kimi-k2.5 keeps
# every transcript inside AU — one env var, no code change.
MODEL_REASONING=anthropic/claude-sonnet-5

# Self-hosted models cold-start: a model that has gone idle can take 30-60s on
# the first request, then answer in well under a second. Expect the first chunk
# of a drive to lag if nobody else has used that model recently.

# --- Storage ----------------------------------------------------------------
# Audio chunks land here. In production this is a Coolify persistent volume
# (/data/storage).
#
# MUST BE ABSOLUTE. Web, worker and the seed scripts each run from their own
# working directory, so a relative path would scatter one session's audio across
# three folders — with no error, just a corpus that quietly does not line up.
STORAGE_DIR=/absolute/path/to/voice-workspace/storage

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth is OPTIONAL. Leave these empty and the app runs guest-only —
# no OAuth app to register before you can record. Fill them in when you want
# recordings to survive a cleared cookie or a second device.
#
# Register TWO apps: one with callback
#   http://localhost:3000/api/auth/callback/github
# and one for the deployed domain. Testing the recorder on a real phone needs a
# tunnel (`pnpm tunnel`), whose URL must also be registered.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
