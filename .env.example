# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. pg-boss shares this database (schema: pgboss).
#
# In production this is the INTERNAL connection URL of the Coolify PGVector 17
# database resource — Postgres is deliberately not part of docker-compose.prod.yml,
# so that Coolify's scheduled backups cover it. Reaching it by internal hostname
# needs "Connect To Predefined Network" enabled on the compose resource.
#
# Extensions and the pgboss schema are applied by `pnpm db:migrate`, so there is
# no manual setup step against a fresh database.
DATABASE_URL=postgresql://voicemural:voicemural@localhost:5432/voicemural

# --- LiteLLM ----------------------------------------------------------------
# All model calls route through the LiteLLM proxy. Never hard-code model names
# in application code — reference the role-based vars below so models can be
# swapped without a code change.
LITELLM_BASE_URL=https://litellm.your-instance.example/v1
LITELLM_API_KEY=sk-...

# Role -> model mapping. Ask your LiteLLM admin for a virtual key per person so
# usage and budget are attributable.
#
# MODEL NAMES ARE INSTANCE-SPECIFIC. The CAVI proxy namespaces everything, so
# bare `whisper-1` does not exist there — it is `openai/whisper-1`. The worker
# checks these against /v1/models on startup and names the ones it can see, so
# a wrong value is reported once at boot instead of failing per chunk.
#
# Defaults below are self-hosted and open source, which keeps recordings of
# people thinking aloud on university infrastructure — worth keeping that way
# once the field study has participants.
MODEL_TRANSCRIBE=cavi/faster-whisper-large-v3
MODEL_FAST=cavi/gemma3:12b

# Crystallisation quality matters more than speed here, so this one defaults to
# a hosted model. Switching to e.g. cavi/gpt-oss:20b or natai/kimi-k2.5 keeps
# every transcript inside AU — one env var, no code change.
MODEL_REASONING=anthropic/claude-sonnet-5

# Self-hosted models cold-start: a model that has gone idle can take 30-60s on
# the first request, then answer in well under a second. Expect the first chunk
# of a drive to lag if nobody else has used that model recently. Measured: 62s
# cold vs 227ms warm on MODEL_FAST.

# --- Talk-back (realtime conversation) --------------------------------------
# Only apps/realtime reads these. Leave TALKBACK_ENABLED unset and the recorder
# behaves exactly as before — capture never depends on any of this.
#
# Run `pnpm spike:talkback` to measure these against your proxy before trusting
# them. It prints a per-stage latency budget and says plainly what is too slow.
TALKBACK_ENABLED=false
# The browser half of the same switch. Separate because NEXT_PUBLIC_* is inlined
# into the client bundle at build time — set BOTH, to the same value, or the
# recorder will open a socket that the service refuses (or vice versa).
NEXT_PUBLIC_TALKBACK_ENABLED=false

# ASR for the live conversation, SEPARATE from the ledger's on purpose.
#
# The worker transcribes 10s chunks at batchSize 4 continuously during a drive,
# so a live turn sharing that deployment queues behind them: measured 1.7s idle
# versus 7.9-10.2s while the chunk pipeline runs. That is the difference between
# a conversation and a broken feature, and it is invisible from the UI.
#
# The ledger keeps large-v3 — quality matters there and latency does not. The
# live path wants a small model on its own queue: latency matters and quality
# does not, because live ASR is a working copy that is NEVER written to the
# utterance ledger. Falls back to MODEL_TRANSCRIBE if unset, which works but is
# slow enough to feel broken.
# MODEL_TRANSCRIBE_LIVE=cavi/faster-distil-whisper-large-v3

# The conversation model. Deliberately NOT MODEL_FAST, for two measured reasons.
#
# cavi/gemma3:12b accepts a `tools` parameter without erroring and then never
# calls one — an agent that silently refuses to look anything up, with no error
# to explain why. And on the same retrieved context it restates transcription
# artefacts as fact ("you're going to show how to build a real-world computer"),
# where claude-sonnet-5 recognises the transcript is garbled and says so — while
# also being FASTER (2.6s vs 3.4s), because the bottleneck is prompt processing
# on a small self-hosted model, not the network.
#
# No privacy change in switching: MODEL_REASONING already sends transcript to
# Anthropic for workspace extraction, so the same speech already leaves AU. It
# does cost more — this runs on every conversational turn, where extraction
# batches eight utterances — so watch the spend on a long deployment.
#
# There is no fallback for this role: an unset value fails loudly instead.
MODEL_CONVERSE=anthropic/claude-sonnet-5

# Text to speech. Self-hosted Piper, ~$0 against ~$100/1M chars on ElevenLabs
# turbo, with an audible quality tradeoff.
#
# THE VOICE IS BAKED INTO THE MODEL ID — there is no `cavi/piper` and no voice
# parameter. Choosing a voice means choosing a model, which is what the role
# indirection is for. Danish: cavi/piper-da_DK-talesyntese-medium
#
# Measured ~61ms fixed + 12.5ms per character, so time-to-first-audio is set by
# how much text goes into the FIRST request — hence splitForSpeech() chunking
# replies on clause boundaries rather than sending them whole.
# MODEL_SPEAK=cavi/piper-en_US-ryan-high

# Which voice provider to use. Defaults to `litellm`, so the option that keeps
# participant-derived text on university infrastructure is the one you get by
# not deciding.
#
#   litellm     Piper today, Kokoro-82M when deployed. On AU hardware, $0, and
#               the same voice for every participant — which is what `persona`
#               needs to be a controlled variable at all.
#   elevenlabs  The realism benchmark. Sends the agent's words — which quote the
#               participant's own thinking back to them — to a US vendor. A
#               smaller step than sending audio, a larger one than sending
#               nothing, and an ethics-form line either way. Cost is trivial
#               here: a reply is one or two sentences, so a long drive is a few
#               thousand characters.
#   synthetic   A speech-shaped buzz, generated locally. NOT a voice: it exists
#               so the audio path can be tested when no provider is reachable.
#               Never a fallback — a study must not record someone listening to
#               it — so it has to be asked for by name.
# TTS_PROVIDER=litellm

# ElevenLabs, called directly rather than through LiteLLM: the parameters that
# matter for a conversational voice have nowhere to live in an OpenAI-shaped
# envelope. Same pattern the video pipeline already uses.
#
# Pick ONE voice and keep it fixed for the whole study.
# eleven_flash_v2_5 is the low-latency model; eleven_v3 trades ~175ms for
# noticeably better prosody, which matters more here than the latency does —
# TTS is ~400ms of an 11-second turn.
#
# MODEL CHOICE IS CONSTRAINED BY THE TRANSPORT, not by preference. Continuous
# speech needs the streaming-input WEBSOCKET — one synthesis fed incrementally,
# rather than a request per sentence, which is what makes the difference between
# speech and stitched-together fragments. Measured against this key:
#
#   eleven_v3          403 on the websocket — HTTP-only, unusable here
#   eleven_turbo_v2_5  works, better prosody than flash
#   eleven_flash_v2_5  works, lowest latency
#
# eleven_v3 sounds best over plain HTTP and cannot be used at all for a live
# conversation. Turbo is the default for that reason.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Piper's sample rate varies by voice and the proxy does not report it. Only
# used for raw `pcm`; a `wav` response carries the true rate in its header.
# MODEL_SPEAK_SAMPLE_RATE=22050

# Embeddings for transcript search. Must be MULTILINGUAL: the corpus is mixed
# German/English and a monolingual embedder silently halves recall. bge-m3 and
# multilingual-e5-large are both 1024-d.
# MODEL_EMBED=

# REALTIME_PORT=3001
# NEXT_PUBLIC_REALTIME_URL=/rt

# Which browser voice to use for the local fallback, matched by name substring
# (e.g. "samantha"). Only used when the server sends no audio — a TTS outage, or
# MODEL_SPEAK unset. Leave unset and the best non-novelty system voice is picked.
# NEXT_PUBLIC_TALKBACK_VOICE=

# --- DEPLOYMENT ONLY (Coolify) ----------------------------------------------
# Not used by `pnpm dev`, and REQUIRED when deploying.
#
# The public domain, WITHOUT scheme — e.g. voice.example.com. This is
# interpolated into the Traefik router rule for the realtime service, which is
# routed on the same origin as the web app under /rt.
#
# There is no sensible default and no error if it is missing: the rule renders
# as Host(``) and talk-back becomes silently unroutable, while web, worker and
# capture all keep working normally. Set it to the same host as BETTER_AUTH_URL.
# REALTIME_HOST=voice.example.com

# --- Storage ----------------------------------------------------------------
# Audio is TRANSIENT: a chunk lives here only until its transcript is committed,
# then it is deleted. The transcript is the record; the audio is scaffolding.
# Expect this directory to sit near empty.
#
# Set KEEP_AUDIO=true to retain it instead. Worth doing before you change
# CHUNK_MS or MODEL_TRANSCRIBE — once audio is gone a corpus cannot be
# re-derived, and the transcript is all you will ever be able to analyse.
# KEEP_AUDIO=true
#
# In production this is a Coolify persistent volume (/data/storage).
#
# MUST BE ABSOLUTE. Web, worker and the seed scripts each run from their own
# working directory, so a relative path would scatter one session's audio across
# three folders — with no error, just a corpus that quietly does not line up.
STORAGE_DIR=/absolute/path/to/voice-workspace/storage

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
# The public origin, with NO port suffix in production and no trailing slash.
# Better Auth builds the OAuth callback and validates request origins from this,
# so it must match what the browser actually asks for and match the callback
# registered on the GitHub app. In production set it by hand rather than deriving
# it from Coolify's SERVICE_FQDN_WEB_3000, which includes the container port.
BETTER_AUTH_URL=http://localhost:3000

# Social sign-in is OPTIONAL and per-provider. Leave a pair empty and that
# button does not appear; leave both empty and the app runs guest-only, with no
# OAuth app to register before you can record. Fill them in when you want
# recordings to survive a cleared cookie or a second device.
#
# Accounts with the same VERIFIED email are linked across providers (see
# accountLinking in apps/web/src/lib/auth.ts). Without that, one person signing
# in with Google on a phone and GitHub on a laptop becomes two users and their
# growth curve splits in half.
#
# GitHub: register TWO apps, one per origin — a single app cannot serve both
#   http://localhost:3000/api/auth/callback/github
# and the deployed domain. Testing the recorder on a real phone needs a tunnel
# (`pnpm tunnel`), whose URL must also be registered.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: ONE client is enough — unlike GitHub it accepts several redirect URIs.
# Add both http://localhost:3000/api/auth/callback/google and the deployed
# domain's. Scopes are openid/email/profile only, which are non-sensitive and so
# need no Google verification review.
#
# Set the consent screen to PUBLISHED, not Testing. In Testing only listed test
# users can sign in (100 max) and refresh tokens expire after 7 days — which
# breaks a longitudinal study weeks in, long after anyone is looking.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Analytics (PostHog) — OPTIONAL -----------------------------------------
# Leave the token empty and every capture call becomes a no-op, in both the
# browser and the worker. A fresh clone still runs with nothing but a database.
#
# The project token is NOT a secret: it is a write-only ingest key that ships in
# the HTML of every page. It is a build arg rather than runtime config only
# because Next inlines NEXT_PUBLIC_* at build time — see apps/web/Dockerfile.
#
# EU cloud. The study records people thinking aloud, so keep the region in the
# EU alongside the rest of the data.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Send the transcript excerpts and model responses to PostHog as $ai_input /
# $ai_output_choices, so AI Observability shows what the model actually saw.
# Set false to keep every generation metadata-only (model, tokens, latency,
# cost) with no participant speech leaving this deployment.
POSTHOG_CAPTURE_AI_CONTENT=true

# --- Workspace extraction ---------------------------------------------------
# Utterances per extraction batch. FIXED on purpose: batch boundaries have to be
# a pure function of the transcript, or a rebuild slices the same speech
# differently, misses the extraction cache and pays for fresh model calls.
WORKSPACE_BATCH_SIZE=8

# --- LiveKit (talk-back transport) ------------------------------------------
# Talk-back runs on LiveKit rather than a hand-rolled WebSocket, because echo
# cancellation, jitter buffering and interruption are things a WebRTC stack does
# properly and a bespoke one does not.
#
# Locally: docker compose -f docker-compose.yml -f docker-compose.livekit.yml up -d
# The dev server accepts the well-known devkey/secret below. Change both in
# production, where LiveKit is another container on AU infrastructure so audio
# never leaves it.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# --- Which talk-back backend runs -------------------------------------------
# livekit (default) or pipecat. They exist side by side to be compared on the
# same voice, models and prompt; whichever loses gets deleted.
#
#   livekit  apps/agent (TypeScript) + the livekit media server container
#   pipecat  apps/pipecat (Python), peer-to-peer WebRTC, no media server
#
# Build-time, like the other NEXT_PUBLIC_ flags, so switching needs a restart.
NEXT_PUBLIC_TALKBACK_BACKEND=livekit
NEXT_PUBLIC_PIPECAT_URL=http://localhost:7860
