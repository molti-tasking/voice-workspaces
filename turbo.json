{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "LITELLM_BASE_URL",
    "LITELLM_API_KEY",
    "MODEL_TRANSCRIBE",
    "MODEL_FAST",
    "MODEL_REASONING",
    // Talk-back roles. MODEL_TRANSCRIBE_LIVE falls back to MODEL_TRANSCRIBE and
    // MODEL_SUMMARISE falls back to MODEL_CONVERSE; see packages/llm/src/config.ts.
    "MODEL_TRANSCRIBE_LIVE",
    "MODEL_CONVERSE",
    "MODEL_SUMMARISE",
    // The talk-back container's own settings. Listed here even though only
    // apps/pipecat reads most of them, because docker-compose.pipecat.yml
    // interpolates them from the same .env that Turbo hashes.
    "NEXT_PUBLIC_PIPECAT_URL",
    "PIPECAT_PORT",
    "WEB_URL",
    "ICE_SERVERS",
    "REALTIME_HOST",
    "STT_PROVIDER",
    "DEEPGRAM_API_KEY",
    "DEEPGRAM_MODEL",
    "DEEPGRAM_UTTERANCE_END_MS",
    "ASSEMBLYAI_API_KEY",
    "ELEVENLABS_API_KEY",
    "ELEVENLABS_VOICE_ID",
    "ELEVENLABS_MODEL_ID",
    "TALKBACK_ENABLED",
    "NEXT_PUBLIC_TALKBACK_ENABLED",
    "STORAGE_DIR",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    // NEXT_PUBLIC_* are inlined into the client bundle at build time, so they
    // are genuine build inputs: without them listed here Turbo would replay a
    // cached bundle carrying the previous token.
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "POSTHOG_CAPTURE_AI_CONTENT",
    "WORKSPACE_BATCH_SIZE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Never cached: integration suites skip themselves when Postgres is
      // unreachable, and a cached "skipped" run replays later as a pass — so a
      // green suite could mean the database was simply down when it last ran.
      "cache": false
    },
    "lint": {}
  }
}
