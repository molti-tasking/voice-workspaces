{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "LITELLM_BASE_URL",
    "LITELLM_API_KEY",
    "MODEL_TRANSCRIBE",
    "MODEL_FAST",
    "MODEL_REASONING",
    // Talk-back roles. MODEL_TRANSCRIBE_LIVE falls back to MODEL_TRANSCRIBE;
    // the rest are required only by apps/realtime.
    "MODEL_TRANSCRIBE_LIVE",
    "MODEL_CONVERSE",
    "MODEL_SPEAK",
    "MODEL_SPEAK_SAMPLE_RATE",
    "TTS_PROVIDER",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "LIVEKIT_URL",
    "NEXT_PUBLIC_LIVEKIT_URL",
    "NEXT_PUBLIC_TALKBACK_BACKEND",
    "NEXT_PUBLIC_PIPECAT_URL",
    "PIPECAT_PORT",
    "ELEVENLABS_API_KEY",
    "ELEVENLABS_VOICE_ID",
    "ELEVENLABS_MODEL_ID",
    "MODEL_EMBED",
    "TALKBACK_ENABLED",
    "NEXT_PUBLIC_TALKBACK_ENABLED",
    "NEXT_PUBLIC_TALKBACK_VOICE",
    "REALTIME_PORT",
    "NEXT_PUBLIC_REALTIME_URL",
    "STORAGE_DIR",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    // NEXT_PUBLIC_* are inlined into the client bundle at build time, so they
    // are genuine build inputs: without them listed here Turbo would replay a
    // cached bundle carrying the previous token.
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "POSTHOG_CAPTURE_AI_CONTENT",
    "WORKSPACE_BATCH_SIZE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Never cached: integration suites skip themselves when Postgres is
      // unreachable, and a cached "skipped" run replays later as a pass — so a
      // green suite could mean the database was simply down when it last ran.
      "cache": false
    },
    "lint": {}
  }
}
