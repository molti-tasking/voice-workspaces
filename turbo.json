{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "LITELLM_BASE_URL",
    "LITELLM_API_KEY",
    "MODEL_TRANSCRIBE",
    "MODEL_FAST",
    "MODEL_REASONING",
    "STORAGE_DIR",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Never cached: integration suites skip themselves when Postgres is
      // unreachable, and a cached "skipped" run replays later as a pass — so a
      // green suite could mean the database was simply down when it last ran.
      "cache": false
    },
    "lint": {}
  }
}
